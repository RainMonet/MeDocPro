# Development Dockerfile for MeDocPro Frontend
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy application code
COPY . .

# Create environment file
RUN echo "VITE_API_BASE_URL=http://localhost:5000" > .env.development && \
    echo "VITE_DEBUG=true" >> .env.development && \
    echo "VITE_APP_TITLE=MeDocPro (Development)" >> .env.development && \
    echo "VITE_ENVIRONMENT=development" >> .env.development

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5173 || exit 1

# Development server with hot reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]