FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=dev_secret_key_change_in_production
JWT_SECRET_KEY=dev_jwt_secret_change_in_production
# DATABASE_URL will use config.py fallback to instance/medocpro.db
REDIS_URL=redis://localhost:6379/0
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://172.24.240.1:5173,http://10.255.255.254:5173
ENCRYPTION_KEY=dev-encryption-key-32-chars-long

# HIPAA Encryption Configuration
HIPAA_MASTER_KEY=ZGV2LWhpcGFhLW1hc3Rlci1rZXktMzItYnl0ZXMtbG9uZw==
DATABASE_ENCRYPTION_KEY=ZGV2LWRhdGFiYXNlLWVuY3J5cHRpb24ta2V5LTMyLWJ5dGVzLWxvbmc=

# Key Management
HIPAA_KEY_STORE_PATH=./secure/keys/hipaa_keys.json
KEY_ROTATION_DAYS=90

# Security Audit Configuration
SECURITY_AUDIT_DB_URL=sqlite:///./instance/security_audit.db
HIPAA_USER_ID=system
HIPAA_SESSION_ID=dev-session

# HIPAA Feature Toggles
HIPAA_ENCRYPTION_ENABLED=true
HIPAA_AUDIT_ENABLED=true

# TLS Configuration (Production)
TLS_CERT_PATH=./certs/hipaa_cert.pem
TLS_KEY_PATH=./certs/hipaa_key.pem
