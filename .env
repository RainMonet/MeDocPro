# MeDocPro Backend Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Flask Application Configuration
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=app.py

# =============================================================================
# Security Configuration (CHANGE THESE IN PRODUCTION!)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://medocpro:secure_password@localhost:5432/medocpro_db

# For development with SQLite (not recommended for production)
# DATABASE_URL=sqlite:///medocpro.db

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# AI Configuration (Ollama)
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=30
OLLAMA_MAX_TOKENS=1000

# =============================================================================
# Redis Configuration (Rate Limiting & Caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_STRATEGY=fixed-window
RATELIMIT_HEADERS_ENABLED=true

# =============================================================================
# HIPAA Compliance Settings
# =============================================================================
# Audit log retention (6 years = 2190 days for HIPAA compliance)
AUDIT_LOG_RETENTION_DAYS=2190

# PHI encryption requirement
PHI_ENCRYPTION_REQUIRED=true

# Access logging level
ACCESS_LOG_LEVEL=INFO

# Data backup settings
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION=true

# =============================================================================
# Application Settings
# =============================================================================
APP_VERSION=1.0.0
APP_NAME=MeDocPro

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:5173

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=10

# Session configuration
SESSION_TIMEOUT_MINUTES=480
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Email templates
FROM_EMAIL=noreply@medocpro.local
ADMIN_EMAIL=admin@medocpro.local

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s: %(message)s [in %(pathname)s:%(lineno)d]
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Audit log configuration
AUDIT_LOG_FORMAT=json
AUDIT_LOG_INCLUDE_REQUEST_BODY=false

# =============================================================================
# Development Settings
# =============================================================================
# Enable debug toolbar (development only)
DEBUG_TOOLBAR=false

# Enable profiling (development only)
PROFILE=false

# Mock external services for testing
MOCK_OLLAMA=false
MOCK_EMAIL=true

# =============================================================================
# Production Settings
# =============================================================================
# SSL/TLS Configuration
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem
SSL_REDIRECT=false

# Gunicorn configuration
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30

# =============================================================================
# Monitoring and Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_STORAGE_PATH=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_DATABASE_URL=sqlite:///:memory:
TEST_REDIS_URL=redis://localhost:6379/15