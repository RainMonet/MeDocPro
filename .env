# .env file for MeDocPro Backend

# Database Configuration
# Replace with your PostgreSQL connection details
# Example for Docker setup: postgresql://medocpro_user:medocpro_password@db:5432/medocpro_db
DATABASE_URL=postgresql://user:password@host:port/database

# Security Configuration
# IMPORTANT: Generate a strong, random key for SECRET_KEY (minimum 32 characters)
SECRET_KEY=your-secret-key-minimum-32-characters
HIPAA_AUDIT_ENABLED=true
# IMPORTANT: Generate a Fernet encryption key. You can generate one using:
# from cryptography.fernet import Fernet
# Fernet.generate_key().decode()
ENCRYPTION_KEY=your-fernet-encryption-key

# API Limits
# Configure API rate limiting
RATE_LIMIT_PER_MINUTE=100
# Specify allowed CORS origins, comma-separated for multiple origins
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# AI Configuration (Optional)
# If you are using AI enhancement, configure your model and API endpoint
# Example if using Ollama with llama2 running locally:
AI_MODEL_NAME=llama2
AI_API_ENDPOINT=http://localhost:11434
# Optional AI parameters
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=500

# Flask Specific (for local development, can be omitted in production if using a WSGI server)
# Set to 'development' for Flask's debug mode and auto-reload
# For production, this should typically be unset or set to 'production'
# FLASK_ENV=development
# FLASK_DEBUG=1