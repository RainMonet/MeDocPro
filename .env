# MeDocPro Environment Configuration

# Flask Configuration
FLASK_APP=app:create_app
FLASK_ENV=development
DEBUG=True

# Security Keys (Generate new keys for production!)
SECRET_KEY=dev_secret_key_change_in_production
JWT_SECRET_KEY=dev_jwt_secret_change_in_production
ENCRYPTION_KEY=dev_encryption_key_change_in_production

# Database Configuration
DATABASE_URL=postgresql://medocpro:secure_password@localhost:5432/medocpro_db
DB_PASSWORD=secure_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# HIPAA Compliance Settings
AUDIT_LOG_RETENTION_DAYS=2190
PHI_ENCRYPTION_REQUIRED=true

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Email Configuration (if needed)
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=structured

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Session Configuration
SESSION_TIMEOUT_MINUTES=480
PERMANENT_SESSION_LIFETIME=28800

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90

# Monitoring
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true

# Development Settings
TESTING=false
WTF_CSRF_ENABLED=false